# =============================================================================
# Katalyst Admin - Production Environment Configuration
# =============================================================================
# This file is loaded when running: npm run build
# Vite automatically loads .env.production for production builds
# =============================================================================

# Application
VITE_APP_NAME=Katalyst Admin
VITE_APP_ENVIRONMENT=production

# API Configuration
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT=30000

# Authentication
VITE_AUTH_LOGIN_PATH=/auth/login
VITE_AUTH_TOKEN_KEY=katalyst_auth_token
VITE_AUTH_CURRENT_USER_KEY=katalyst_auth_current_user

# Mock Service Worker - Enable for demo purposes
# Set to 'true' to use MSW mock handlers even in production (demo mode)
# Set to 'false' to use real API endpoints
VITE_USE_MSW=true
